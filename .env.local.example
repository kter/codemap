# ─────────────────────────────────────────────────────────────────────────────
#  CodeMap — Local backend environment variables
#
#  Copy this file:
#    cp .env.local.example .env.local
#  Then fill in your values and source it before running the backend:
#    set -a && source .env.local && set +a
#  Or use direnv: add `dotenv .env.local` to .envrc (after `use mise`).
# ─────────────────────────────────────────────────────────────────────────────

# Enable local HTTP server mode (uses axum::serve instead of lambda_http::run)
LOCAL_SERVER=1

# Port for the local API server
PORT=8080

# ── DynamoDB Local ────────────────────────────────────────────────────────────
# Point the AWS SDK at DynamoDB Local (Docker).
# Run `make dynamo-up` to start it and create the tables.
AWS_ENDPOINT_URL_DYNAMODB=http://localhost:8000

# DynamoDB table names (created by scripts/create-local-tables.sh)
SESSIONS_TABLE=codemap-local-sessions
AI_CACHE_TABLE=codemap-local-ai-cache

# ── AWS credentials ───────────────────────────────────────────────────────────
# Use your AWS profile so that Bedrock calls (AI analysis) reach the real AWS.
# The DynamoDB Local endpoint override above routes DynamoDB traffic locally
# regardless of which profile you use.
AWS_PROFILE=dev
AWS_DEFAULT_REGION=ap-northeast-1

# ── GitHub OAuth (local dev — not used in Lambda mode) ───────────────────────
# GitHub client credentials (optional; only needed if you test the real OAuth flow locally)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Dev login ─────────────────────────────────────────────────────────────────
# A GitHub Personal Access Token with `repo` and `read:user` scopes.
# This is injected into the dev session so that /tree, /file, /analyze can
# call the real GitHub API without going through the OAuth flow.
DEV_GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEV_GITHUB_LOGIN=your-github-username

# ── URLs ──────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
API_BASE_URL=http://localhost:8080
